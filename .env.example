# Templates only. Configure actual secrets privately in Render, never in Git or chat.
OFFICE_BACKEND=supabase
SUPABASE_URL=https://qwfiwqknzrbhamhzwoga.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SECRET_KEY=replace-with-a-new-secret-key-after-revoking-exposed-keys
# Copy the Supabase session/transaction pooler PostgreSQL URI, with its DB password.
DATABASE_URL=postgresql://replace-user:replace-password@replace-pooler-host:5432/postgres
SUPABASE_STORAGE_BUCKET=office-invoices
OFFICE_OWNER_EMAIL=replace-with-your-admin-email
OFFICE_CONNECTOR_TOKEN=replace-with-a-new-random-value-of-at-least-32-characters
OFFICE_PUBLIC_URL=https://replace-with-your-render-host.onrender.com
OFFICE_SECURE_COOKIE=YES
OFFICE_ENABLE_POSTING=NO

# Optional additional confirmed full-access admins, comma-separated; signup remains disabled.
OFFICE_ADMIN_EMAILS=
